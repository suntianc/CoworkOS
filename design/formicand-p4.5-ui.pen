        },
        {
          "type": "text",
          "id": "m4NJ1I",
          "name": "Text",
          "fill": "#A1A1A8",
          "textGrowth": "fixed-width",
          "width": 470,
          "content": "· < 1024：侧栏收为 56 图标栏；项目悬停展开浮层树，Main 提问提示点显示在项目图标上",
          "lineHeight": 1.6,
          "fontFamily": "Noto Sans SC",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "C1MmF",
          "name": "Text",
          "fill": "#A1A1A8",
          "textGrowth": "fixed-width",
          "width": 470,
          "content": "· Web 窄屏（< 640）：单栏，侧栏与需求进度均为全屏抽屉",
