{
  "schemaVersion": 1,
  "stages": [
    {
      "id": "basic",
      "name": "一 基础功能"
    },
    {
      "id": "cli",
      "name": "二 CLI 专门功能"
    },
    {
      "id": "app",
      "name": "三 App 功能"
    },
    {
      "id": "applications",
      "name": "四 App 内应用功能"
    },
    {
      "id": "cases",
      "name": "五 用户 case"
    }
  ],
  "rules": [
    {
      "stage": "cases",
      "node": "^(science-removal|machine-learning-skill-pi|publish-artifact-pi|automation-pi|main-recovery-pi|application-bootstrap-pi|input-files-pi|vision-session|live-ui)\\.test\\.js$",
      "browser": "^(human-interactions|message-delivery|conversation-integrity|request-recovery)\\.spec\\.js$"
    },
    {
      "stage": "cli",
      "node": "^(cli-onboarding|cli-commands|agent-smoke-cli|reasoning-launcher|main-run-env)\\.test\\.js$",
      "browser": "(?!)"
    },
    {
      "stage": "applications",
      "node": "^(application-|binding-|computer-|text-document-session|software-boundaries|independent-instance-model|workspace-text)",
      "browser": "^(app-instances|binding-menu|collaboration-picker|computer-use|independent-applications|local-file-open|original-file|recovery-review|workbench|workspace-applications|workspace-projects)"
    },
    {
      "stage": "app",
      "node": "^(desktop-|composer-|conversation-view|artifact-ui|artifact-navigation|voice-input|markdown|workbench-dom|workbench-ui|tab-refresh|workbench-tab-identity|model-settings|app-boot|request-error)"
    }
  ],
  "nativeNode": [
    "test/computer-native.test.js"
  ],
  "nativeBrowserPattern": "-desktop\\.spec\\.js$",
  "nativeVariants": [
    {
      "file": "e2e/science-removal.spec.js",
      "kind": "browser",
      "pattern": "Electron removes science controls"
    },
    {
      "file": "e2e/model-profiles.spec.js",
      "kind": "browser",
      "pattern": "desktop: saved connections"
    },
    {
      "file": "test/desktop-dev.test.js",
      "kind": "node",
      "pattern": "Finder development entry|Mac launch gives",
      "enableEnv": "ATRIA_NATIVE_DESKTOP_TEST"
    },
    {
      "file": "test/desktop-update-install.test.js",
      "kind": "node",
      "pattern": "native disposable App update",
      "enableEnv": "ATRIA_MANAGED_UPDATE_NATIVE"
    }
  ],
  "anchors": [
    {
      "cases": [
        "INTERACT-02",
        "INTERACT-03",
        "INTERACT-05",
        "INTERACT-06",
        "INTERACT-08",
        "INTERACT-15",
        "APPHUMAN-15"
      ],
      "files": [
        "test/main-inbox-delivery.test.js",
        "e2e/message-delivery.spec.js",
        "test/conversation.test.js"
      ],
      "note": "已有补充/排队/晋升/取消及持久投递断言；新目录的全部竞态仍需逐项核对。"
    },
    {
      "cases": [
        "CLI-01",
        "CLI-02",
        "CLI-03",
        "CLI-04",
        "CLI-06",
        "CLI-07"
      ],
      "files": [
        "test/cli-onboarding.test.js",
        "test/agent-smoke-cli.test.js"
      ],
      "note": "已有命令/初始化回归；最终 tgz 的独立安装和真实 PTY 仍单列。"
    },
    {
      "cases": [
        "APPHUMAN-02",
        "APPHUMAN-05",
        "APPHUMAN-06",
        "COMPOSER-02",
        "COMPOSER-03"
      ],
      "files": [
        "e2e/message-boundaries.spec.js",
        "e2e/message-delivery.spec.js"
      ],
      "note": "已有草稿、队列和晚返回场景；不能据此声称丢响应或预期 Run 校验已完整覆盖。"
    },
    {
      "cases": [
        "APPCHAT-01",
        "APPCHAT-02",
        "APPCHAT-04",
        "APPCHAT-07",
        "APPCHAT-08"
      ],
      "files": [
        "test/conversation-api.test.js",
        "test/conversation-view.test.js",
        "e2e/conversation-integrity.spec.js"
      ],
      "note": "已有轮次/历史断言，五轮完整任务与原生重启仍需按目录验收。"
    },
    {
      "cases": [
        "TXT-01",
        "TXT-02",
        "TXT-03",
        "TXT-04",
        "TXT-05"
      ],
      "files": [
        "e2e/workbench.spec.js"
      ],
      "note": "已有文本资源/草稿与工作台测试；按应用手册核对具体子项。"
    },
    {
      "cases": [
        "GUI-01",
        "GUI-02",
        "GUI-03",
        "GUI-04",
        "GUI-05",
        "GUI-06"
      ],
      "files": [
        "test/computer-use.test.js",
        "test/computer-http.test.js",
        "test/computer-native.test.js",
        "e2e/computer-use.spec.js",
        "e2e/computer-global.spec.js",
        "e2e/computer-settings-desktop.spec.js"
      ],
      "note": "设置单开关全局允许观察和操作，按任务自动选窗；Electron 隔离驱动验证保存与重启，真实原生输入仍需要系统授权。"
    },
    {
      "cases": [
        "APPINSTANCE-01",
        "APPINSTANCE-02",
        "APPINSTANCE-03",
        "APPINSTANCE-04"
      ],
      "files": [
        "test/independent-instance-model.test.js"
      ],
      "note": "独立实例/工作区/原文件使用生产路径；新清单仍标部分映射。"
    },
    {
      "cases": [
        "CASE-04",
        "CASE-05",
        "CASE-06",
        "CASE-07",
        "CASE-08",
        "CASE-09",
        "CASE-12",
        "CASE-13",
        "CASE-18",
        "CASE-20"
      ],
      "files": [
        "test/main-recovery-pi.test.js",
        "test/publish-artifact-pi.test.js",
        "test/science-removal.test.js",
        "e2e/message-delivery.spec.js"
      ],
      "note": "复用已有确定性链路；这些文件通过不等于真实模型完成全部用户 case。"
    }
  ],
  "manual": [
    {
      "id": "release-cli-install",
      "stage": "cli",
      "document": "docs/testing-case-catalog.md",
      "description": "最终 tgz 独立 prefix 安装、首次配置、PTY、停止与继续、支持平台。"
    },
    {
      "id": "release-app-package",
      "stage": "app",
      "document": "docs/testing-execution-guide.md",
      "description": "最终 DMG 安装、Finder 启动、退出/重启、前版升级、签名/公证与干净用户。"
    },
    {
      "id": "release-app-native",
      "stage": "app",
      "document": "docs/testing-case-catalog.md",
      "description": "原生窗口、IPC、草稿、模型配置与协议的实际桌面体验。"
    },
    {
      "id": "release-applications",
      "stage": "applications",
      "document": "docs/testing-application-release.md",
      "description": "TXT 固定素材、实际文件/工程、布局与体验。"
    },
    {
      "id": "release-computer-use",
      "stage": "applications",
      "document": "docs/testing-application-release.md",
      "description": "解锁 Mac 的系统权限、真实输入与保存、接管；宽松策略单列待实现。"
    },
    {
      "id": "release-live-cases",
      "stage": "cases",
      "document": "docs/testing-case-catalog.md",
      "description": "真实模型两端任务、费用、独立产物与人类交互；不会自动调用收费模型。"
    },
    {
      "id": "release-coverage-review",
      "stage": "basic",
      "document": "docs/testing-case-catalog.md",
      "description": "逐项核对全部规划的具体断言，文件映射仅为部分覆盖线索。"
    }
  ]
}
